import sys
import time
import threading
import pyautogui
import keyboard
import random
import base64
from PyQt5.QtWidgets import QApplication, QSystemTrayIcon, QMenu, QAction, QInputDialog
from PyQt5.QtGui import QIcon, QPixmap

class MouseMover:
    def __init__(self):
        self.running = True
        self.paused = False
        self.mouse_movement_enabled = True
        self.key_press_enabled = True
        self.mouse_interval_lower = 30
        self.mouse_interval_upper = 900
        self.key_interval_lower = 30
        self.key_interval_upper = 900
        self.tray_icon = None

    def move_mouse(self):
        while self.running:
            if not self.paused and self.mouse_movement_enabled:
                interval = random.randint(self.mouse_interval_lower, self.mouse_interval_upper)
                pyautogui.move(random.choice([-1, 1]), 0)
                time.sleep(interval)
            else:
                time.sleep(1)

    def press_f15(self):
        while self.running:
            if not self.paused and self.key_press_enabled:
                interval = random.randint(self.key_interval_lower, self.key_interval_upper)
                keyboard.press_and_release('F15')
                time.sleep(interval)
            else:
                time.sleep(1)

    def create_tray_icon(self):
        self.tray_icon = QSystemTrayIcon()
        icon_data = base64.b64decode(icon_base64)
        pixmap = QPixmap()
        pixmap.loadFromData(icon_data)
        self.tray_icon.setIcon(QIcon(pixmap))
        self.tray_icon.setToolTip("uwu")

        self.tray_menu = QMenu()
        settings_menu = QMenu("Options", self.tray_menu)

        self.toggle_mouse_action = QAction(f"Mouse Movement: {'On' if self.mouse_movement_enabled else 'Off'}", settings_menu, triggered=self.toggle_mouse_movement)
        self.toggle_key_press_action = QAction(f"Key Press - F15: {'On' if self.key_press_enabled else 'Off'}", settings_menu, triggered=self.toggle_key_press)

        self.set_mouse_interval_action = QAction("Set Mouse Interval", settings_menu, triggered=lambda: self.set_interval('mouse'))
        self.set_key_interval_action = QAction("Set Key Interval", settings_menu, triggered=lambda: self.set_interval('key'))

        settings_menu.addAction(self.toggle_mouse_action)
        settings_menu.addAction(self.toggle_key_press_action)
        settings_menu.addAction(self.set_mouse_interval_action)
        settings_menu.addAction(self.set_key_interval_action)

        self.tray_menu.addMenu(settings_menu)
        self.toggle_pause_action = QAction("Pause", self.tray_menu, triggered=self.toggle_pause)
        self.exit_action = QAction("Exit", self.tray_menu, triggered=self.exit_script)

        self.tray_menu.addAction(self.toggle_pause_action)
        self.tray_menu.addAction(self.exit_action)

        self.tray_icon.setContextMenu(self.tray_menu)
        self.tray_icon.show()

    def toggle_pause(self):
        self.paused = not self.paused
        self.toggle_pause_action.setText("Unpause" if self.paused else "Pause")

    def toggle_mouse_movement(self):
        self.mouse_movement_enabled = not self.mouse_movement_enabled
        self.toggle_mouse_action.setText(f"Mouse Movement: {'On' if self.mouse_movement_enabled else 'Off'}")

    def toggle_key_press(self):
        self.key_press_enabled = not self.key_press_enabled
        self.toggle_key_press_action.setText(f"Key Press: {'On' if self.key_press_enabled else 'Off'}")

    def set_interval(self, action):
        # Prompt for the lower bound of the interval
        lower_bound, ok = QInputDialog.getInt(None, "Set Interval", f"Set minimum time for {action.capitalize()} in (seconds):", value=30, min=1, max=15998)
        if ok:
            # Prompt for the upper bound of the interval
            upper_bound, ok = QInputDialog.getInt(None, "Set Interval", f"Set max time for {action.capitalize()} in (seconds):", value=900, min=lower_bound + 1, max=15999)
            if ok:
                if action == 'mouse':
                    self.mouse_interval_lower = lower_bound
                    self.mouse_interval_upper = upper_bound
                elif action == 'key':
                    self.key_interval_lower = lower_bound
                    self.key_interval_upper = upper_bound

    def exit_script(self):
        self.running = False
        self.tray_icon.hide()
        QApplication.quit()

# Base64 encoded icon string placeholder
icon_base64 = ""

if __name__ == '__main__':
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)

    mouse_mover = MouseMover()

    mouse_move_thread = threading.Thread(target=mouse_mover.move_mouse, daemon=True)
    f15_press_thread = threading.Thread(target=mouse_mover.press_f15, daemon=True)

    mouse_move_thread.start()
    f15_press_thread.start()

    mouse_mover.create_tray_icon()

    sys.exit(app.exec_())
